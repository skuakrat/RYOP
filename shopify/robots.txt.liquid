{% comment %}
  Custom robots.txt — renders Shopify's default rules, then explicitly allows AI crawlers.
  File location in theme: templates/robots.txt.liquid
{% endcomment %}
{% for group in robots.default_groups -%}
  {{- group.user_agent }}
  {% for rule in group.rules -%}
    {{ rule }}
  {% endfor -%}
  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {% endif %}
{%- endfor %}

